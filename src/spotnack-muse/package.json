{
  "name": "spotnack-muse",
  "version": "1.0.0",
  "description": "Global Package for Spotnack Muse Application",
  "keywords": [],
  "author": "Lucas Camponogara Viera",
  "license": "ISC",
  "main": "server.js",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "client": "yarn workspace client start",
    "server": "yarn workspace server dev",
    "dev": "cross-env NODE_ENV=development concurrently -k -n CLIENT,SERVER -c blue,green \"yarn client\" \"yarn server\"",
    "client:build": "yarn workspace client build",
    "server:prod": "cross-env NODE_ENV=production yarn workspace server start",
    "prod": "cross-env NODE_ENV=production concurrently -k -n CLIENT,SERVER -c blue,green \"yarn client:build\" \"yarn server:prod\"",
    "build:production": "yarn workspace client build:production",
    "client:android": "yarn workspace client android",
    "client:ios": "yarn workspace client ios",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest --config jest.config.cjs",
    "lint": "eslint client && eslint server --config server/eslint.config.js",
    "lint:fix": "eslint client --fix && eslint server --config server/eslint.config.js --fix"
  },
  "engines": {
    "node": "26.13.0",
    "yarn": "4.18.1"
  },
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "cross-env": "7.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.4",
    "@eslint/js": "^9.38.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jsdoc": "^60.8.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "jest": "~30.5.2",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
