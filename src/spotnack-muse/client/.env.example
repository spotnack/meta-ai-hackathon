# Copy to .env.local (git-ignored via .env*.local) and fill in values.
# EXPO_PUBLIC_* variables are inlined by Metro at bundle time.

# Image-to-3D adapter: "placeholder" (default, simulated) or "demo"
# (serves the cloud-GPU goldens for the hackathon demo).
EXPO_PUBLIC_IMAGE_TO_3D_MODE=placeholder

# Auth mode: unset (default, Express/Cognito login) or "demo" (local
# guest session, no backend; set only in the preview EAS profile).
# EXPO_PUBLIC_AUTH_MODE=demo

# Demo mode is fully offline: the 5 golden inputs and their display
# meshes are bundled in the app (git-ignored local-only demo artifacts).
# No goldens server needed. (Preview EAS builds set
# EXPO_PUBLIC_IMAGE_TO_3D_MODE=demo via eas.json env.)
